# 이 파일은 "어떤 환경 변수가 필요한지"를 알려주는 예시입니다.
# 실제 키가 들어간 .env 파일은 .gitignore 에 등록되어 있어 커밋되지 않습니다.
#
# 로컬 실행:  이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
# 배포 환경:  Vercel 대시보드 → Settings → Environment Variables 에 등록하세요.

# API 키 (필수)
OPENAI_API_KEY=여기에_본인_키를_넣으세요

# API 서버 주소 (선택)
# - 비워 두면 OpenAI 본사(https://api.openai.com/v1)로 호출합니다.
# - 학교/회사에서 제공하는 OpenAI 호환 프록시를 쓴다면 그 주소를 넣으세요.
#   보통 .../v1 까지 적으면 됩니다. 코드가 뒤에 /chat/completions 를 붙입니다.
# OPENAI_BASE_URL=https://호환-프록시-주소/v1

# 사용할 모델 (선택) — 비워 두면 gpt-4o-mini 를 씁니다.
OPENAI_MODEL=gpt-4o-mini

# 파라미터 조합 (선택) — full | gpt5 | gpt5-plain | minimal
# 모델·서버마다 받아주는 옵션이 달라서, 비워 두면 서버가 400을 줄 때마다
# 조합을 하나씩 줄이며 자동으로 맞는 것을 찾습니다.
# 터미널에 "'gpt5' 조합에서 성공" 같은 안내가 뜨면 그 값을 여기 적어두세요.
# 매번 실패 요청을 보내지 않아 첫 응답이 빨라집니다.
#   full       : GPT-4 계열 (temperature + max_tokens + JSON 모드)
#   gpt5       : GPT-5 계열 (max_completion_tokens + JSON 모드)
#   gpt5-plain : 위에서 JSON 모드 제외
#   minimal    : model 과 messages 만
# OPENAI_PARAM_STYLE=gpt5
